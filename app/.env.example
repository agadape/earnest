# Copy to .env.local. `npm run setup` fills in the first two for you and leaves the rest alone.

# The Solana RPC node the browser talks to.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899

# The token the app shows as dollars: the demo token created by `npm run setup`.
NEXT_PUBLIC_MINT=

# Set to 1 to offer a play-money wallet that lives in the browser, and a "Get demo dollars"
# button backed by POST /api/faucet. Leave it out wherever the token is worth something.
NEXT_PUBLIC_DEMO_WALLET=1

# Server only, never sent to the browser. The secret key that pays for the faucet, as a JSON
# array of 64 numbers (the format of a solana-keygen file). It has to be the mint authority of
# NEXT_PUBLIC_MINT and, outside a local validator, hold SOL to hand out for fees.
# Unset, the faucet falls back to .keys/faucet.json; with neither, it refuses to run.
# FAUCET_SECRET_KEY=[1,2,3]

# Server only, optional. The RPC node the faucet uses, if it differs from NEXT_PUBLIC_RPC_URL.
# RPC_URL=
