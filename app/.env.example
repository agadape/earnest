# Copy to .env.local. `npm run setup` fills in the first two for you and leaves the rest alone.

# The Solana RPC node the browser talks to.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899

# The token the app shows as dollars: the demo token created by `npm run setup`.
NEXT_PUBLIC_MINT=

# Set to 1 to offer a play-money wallet that lives in the browser, and a "Get demo dollars"
# button backed by POST /api/faucet. Leave it out wherever the token is worth something.
NEXT_PUBLIC_DEMO_WALLET=1

# Where the site is reachable from outside, e.g. https://example.com. Link previews (the title,
# text and picture X, Telegram or Discord show for a pasted link) need absolute addresses, and
# this is what they start with. Unset, a Vercel deployment uses its production domain
# (VERCEL_PROJECT_PRODUCTION_URL) and everything else http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=

# Server only, never sent to the browser. The secret key that pays for the faucet and for the
# payouts the server sends by itself (refunds, the fee, the creator's share), as a JSON array of
# 64 numbers (the format of a solana-keygen file). It has to be the mint authority of
# NEXT_PUBLIC_MINT and, outside a local validator, hold SOL for fees. It cannot touch the
# program's config or any vault.
# Unset, the server falls back to .keys/faucet.json; with neither, both features refuse to run.
# FAUCET_SECRET_KEY=[1,2,3]

# Server only. Lets Vercel's daily cron call GET /api/settle, which sweeps every campaign for
# payouts nobody triggered from a browser. Any long random string; Vercel sends it back as
# `Authorization: Bearer …`.
# CRON_SECRET=

# Server only, optional. The RPC node the faucet uses, if it differs from NEXT_PUBLIC_RPC_URL.
# RPC_URL=
